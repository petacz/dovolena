# Only local PC access by default:
BIND_ADDRESS=127.0.0.1
# For LAN on Raspberry Pi, use BIND_ADDRESS=0.0.0.0 and a strong password.
APP_PASSWORD=

# Fail closed rather than silently truncating a larger catalog:
MAX_IMPORT_HOTELS=500

# Maximum discovered room-code price lookups per hotel:
MAX_PRICE_REQUESTS_PER_HOTEL=16
